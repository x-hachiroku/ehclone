{
  "cache": "/cache",
  "dest": "/dest",
  "pipeline_interval_seconds": 300,
  "log": {
    "console_level": "INFO",
    "file_level": "WARNING",
    "dir": "/appdata/logs"
  },
  "db": {
    "url": "postgresql+psycopg2://pguser:pgpass@localhost:5432/ehclone"
  },
  "eh": {
    "recheck": 0,
    "base_url": "https://e-hentai.org",
    "proxy": null,
    "cookies": {
      "ipb_member_id": "",
      "ipb_pass_hash": "",
      "igneous": "",
      "star": "",
      "nw": "1"
    },
    "torrent_key": null,
    "categories": [
      "Doujinshi",
      "Manga"
    ],
    "keywords": [],
    "include_expunged": true,
    "extra_args": {
      "disable_uploader_filter": true,
      "disable_tags_filter": true
    },
    "min_request_interval": 5,
    "max_retry": 5
  },
  "filter": {
    "include_categories": [],
    "include_tags": [],
    "not_before_min": 60,
    "min_rating": 0,
    "dedupe": {
      "enabled": true,
      "thumb_dir": "/downloads/thumbs",
      "page_tolerance": 4,
      "page_tolerance_rate": 0.025,
      "page_tolerance_ad": 8,
      "distance_threshold": 0.05,
      "candidate_limit": 128,
      "rating_factor": 20,
      "page_count_factor": 5,
      "expunged_tags": [
        "other:already uploaded",
        "other:defaced",
        "other:replaced",
        "other:compilation",
        "other:incomplete",
        "other:missing cover",
        "other:out of order",
        "other:sample",
        "other:scanmark",
        "other:watermarked"
      ],
      "expunged_bias": -100,
      "tag_biases": {
        "other:rough translation": -30,
        "other:extraneous ads": -20,
        "other:full censorship": -20,
        "other:mosaic censorship": -20,
        "other:uncensored": 50
      }
    }
  },
  "aria2": {
    "url": "http://host.containers.internal:7000/jsonrpc",
    "token": null,
    "remote_dir": "/mnt/kitchen/aria2/ehclone",
    "local_dir": "/cache/aria2/ehclone",
    "task_limit": 128
  },
  "qbit": {
    "enabled": true,
    "url": "http://host.containers.internal:7500",
    "username": "admin",
    "password": "",
    "category": "eh",
    "remote_dir": "/downloads/eh",
    "local_dir": "/qbit",
    "task_limit": 1024,
    "timeout_hours": 168
  },
  "archiver": {
    "cmd": [
      "rar",
      "a",
      "-htb",
      "-k",
      "-ep",
      "-r",
      "-m0",
      "-oi2",
      "-qo",
      "-rr3p",
      "-t",
      "$dst",
      "$src"
    ],
    "extension": ".cbr",
